    "Creates a new UUID and optionally copies it to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine neue UUID und kopiert sie auf Wunsch in die Zwischenablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuevo UUID y, si quieres, lo copia en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un nouvel UUID et le copie si besoin dans le presse-papiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया UUID बनाता है और चाहें तो उसे क्लिपबोर्ड पर कॉपी करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuovo UUID e, se vuoi, lo copia negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいUUIDを作成し、必要に応じてクリップボードにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 UUID를 생성하고 원하는 경우 클립보드에 복사합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een nieuwe UUID aan en kopieert die desgewenst naar het klembord."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um novo UUID e, se quiser, copia-o para a área de transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает новый UUID и при необходимости копирует его в буфер обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir UUID oluşturur ve isteğe bağlı olarak panoya kopyalar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo UUID mới và tùy chọn sao chép vào bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成一个新的 UUID，并可选择拷贝到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生一個新的 UUID，並可選擇拷貝到剪貼板。"
          }
        }
      }
