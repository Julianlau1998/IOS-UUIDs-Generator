    "Every ID you copy is saved, searchable and can get a note.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede kopierte ID wird gespeichert, ist durchsuchbar und kann eine Notiz bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ID que copias se guarda, se puede buscar y puede llevar una nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ID copié est enregistré, consultable et peut recevoir une note."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कॉपी की गई हर ID सहेजी जाती है, खोजी जा सकती है और उसमें नोट जोड़ा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ID che copi viene salvato, è ricercabile e può avere una nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたIDはすべて保存され、検索やメモの追加ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 모든 ID가 저장되며, 검색하고 메모를 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke ID die je kopieert, wordt bewaard, is doorzoekbaar en kan een notitie krijgen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ID que você copia é salvo, pode ser buscado e receber uma nota."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый скопированный ID сохраняется, доступен для поиска и может получить заметку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyaladığın her kimlik kaydedilir, aranabilir ve not eklenebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ID bạn sao chép đều được lưu, có thể tìm kiếm và thêm ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个拷贝过的 ID 都会被保存，可搜索，还可添加备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個拷貝過的 ID 都會被儲存，可搜尋，還可加入備註。"
          }
        }
      }
    },
