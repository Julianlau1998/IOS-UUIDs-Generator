    "Showing the first %lld of %@ UUIDs. Save or share the file to get the complete list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angezeigt werden die ersten %1$lld von %2$@ UUIDs. Speichere oder teile die Datei, um die vollständige Liste zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran los primeros %1$lld de %2$@ UUID. Guarda o comparte el archivo para obtener la lista completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des %1$lld premiers UUID sur %2$@. Enregistre ou partage le fichier pour obtenir la liste complète."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ UUID में से पहले %1$lld दिखाए जा रहे हैं। पूरी सूची पाने के लिए फ़ाइल सहेजें या शेयर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono mostrati i primi %1$lld di %2$@ UUID. Salva o condividi il file per ottenere l’elenco completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 個のUUIDのうち最初の%1$lld個を表示しています。完全なリストを入手するにはファイルを保存または共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID %2$@개 중 처음 %1$lld개를 표시하고 있습니다. 전체 목록을 받으려면 파일을 저장하거나 공유하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste %1$lld van %2$@ UUID's worden getoond. Bewaar of deel het bestand voor de volledige lijst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os primeiros %1$lld de %2$@ UUIDs. Salve ou compartilhe o arquivo para obter a lista completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано UUID: %1$lld из %2$@. Сохраните файл или поделитесь им, чтобы получить полный список."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ UUID’nin ilk %1$lld tanesi gösteriliyor. Listenin tamamı için dosyayı kaydet veya paylaş."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hiển thị %1$lld UUID đầu tiên trong số %2$@. Lưu hoặc chia sẻ tệp để có danh sách đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示 %2$@ 个 UUID 中的前 %1$lld 个。存储或共享文件以获取完整列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在顯示 %2$@ 個 UUID 中的前 %1$lld 個。儲存或分享檔案以取得完整列表。"
          }
        }
      }
    },
