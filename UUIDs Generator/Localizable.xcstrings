    "100 times larger lists, without ads": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100-mal größere Listen, ohne Werbung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas 100 veces más grandes, sin anuncios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des listes 100 fois plus grandes, sans pub"
          }
        },
        "hi": {
