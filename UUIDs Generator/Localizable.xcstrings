    "Based on a timestamp and a node. The node is random, so no device information is included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basiert auf Zeitstempel und Node. Der Node ist zufällig, es sind also keine Geräteinformationen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en una marca de tiempo y un nodo. El nodo es aleatorio, así que no incluye información del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basé sur un horodatage et un nœud. Le nœud est aléatoire, aucune information sur l’appareil n’est donc incluse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टाइमस्टैम्प और नोड पर आधारित। नोड रैंडम होता है, इसलिए इसमें डिवाइस की कोई जानकारी शामिल नहीं होती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basato su un timestamp e un nodo. Il nodo è casuale, quindi non include informazioni sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムスタンプとノードに基づきます。ノードはランダムなので、デバイス情報は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임스탬프와 노드를 기반으로 합니다. 노드는 무작위이므로 기기 정보가 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op een tijdstempel en een node. De node is willekeurig, dus er zit geen apparaatinformatie in."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseado em um carimbo de data/hora e um nó. O nó é aleatório, então nenhuma informação do dispositivo é incluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основан на временной метке и узле. Узел случайный, поэтому данные об устройстве не включаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir zaman damgası ve bir düğüme dayanır. Düğüm rastgeledir, bu nedenle hiçbir aygıt bilgisi içermez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa trên dấu thời gian và node. Node là ngẫu nhiên nên không chứa thông tin thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于时间戳和节点。节点为随机值，因此不含任何设备信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於時間戳記和節點。節點為隨機值，因此不含任何裝置資訊。"
          }
        }
      }
    },
