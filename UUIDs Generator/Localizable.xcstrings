    "122 random bits. The most common choice for IDs that reveal nothing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "122 zufällige Bits. Die gängigste Wahl für IDs, die nichts verraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "122 bits aleatorios. La opción más habitual para ID que no revelan nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "122 bits aléatoires. Le choix le plus courant pour des ID qui ne révèlent rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "122 रैंडम बिट। ऐसी ID के लिए सबसे आम विकल्प जो कोई जानकारी ज़ाहिर नहीं करतीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "122 bit casuali. La scelta più comune per ID che non rivelano nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "122ビットのランダム値。何の情報も含まないIDとして最も一般的な選択肢です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "122개의 무작위 비트. 아무 정보도 드러내지 않는 ID에 가장 많이 쓰이는 선택입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "122 willekeurige bits. De meest gebruikte keuze voor ID's die niets prijsgeven."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "122 bits aleatórios. A escolha mais comum para IDs que não revelam nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "122 случайных бита. Самый популярный выбор для ID, которые ничего не раскрывают."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "122 rastgele bit. Hiçbir şey açığa çıkarmayan kimlikler için en yaygın seçim."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "122 bit ngẫu nhiên. Lựa chọn phổ biến nhất cho các ID không tiết lộ thông tin gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "122 个随机位。最常用的选择，ID 不会泄露任何信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "122 個隨機位元。最常用的選擇，ID 不會洩露任何資訊。"
          }
        }
      }
    },
    "A UUID has 32 hexadecimal digits, usually grouped as 8-4-4-4-12.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine UUID hat 32 Hexadezimalziffern, meist gruppiert als 8-4-4-4-12."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un UUID tiene 32 dígitos hexadecimales, normalmente agrupados como 8-4-4-4-12."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un UUID comporte 32 chiffres hexadécimaux, généralement groupés en 8-4-4-4-12."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID में 32 हेक्साडेसिमल अंक होते हैं, जिन्हें आमतौर पर 8-4-4-4-12 के समूहों में लिखा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un UUID ha 32 cifre esadecimali, di solito raggruppate come 8-4-4-4-12."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UUIDは32桁の16進数で、通常は8-4-4-4-12に区切って表記します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID는 16진수 32자리로 구성되며, 보통 8-4-4-4-12로 묶어 표기합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een UUID bestaat uit 32 hexadecimale cijfers, meestal gegroepeerd als 8-4-4-4-12."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um UUID tem 32 dígitos hexadecimais, geralmente agrupados como 8-4-4-4-12."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID состоит из 32 шестнадцатеричных цифр, обычно сгруппированных как 8-4-4-4-12."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir UUID, genellikle 8-4-4-4-12 şeklinde gruplanan 32 onaltılık basamaktan oluşur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một UUID có 32 chữ số thập lục phân, thường được nhóm theo dạng 8-4-4-4-12."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID 由 32 位十六进制数字组成，通常按 8-4-4-4-12 分组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID 由 32 位十六進位數字組成，通常按 8-4-4-4-12 分組。"
          }
        }
      }
    },
