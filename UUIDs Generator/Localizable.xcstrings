    "Ask Siri for a new UUID or use it in your own shortcuts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Siri nach einer neuen UUID oder nutze sie in deinen Kurzbefehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a Siri un nuevo UUID o úsalo en tus propios atajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande un nouvel UUID à Siri ou utilise-le dans tes propres raccourcis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri से नया UUID माँगें या इसे अपने शॉर्टकट्स में इस्तेमाल करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a Siri un nuovo UUID o usalo nei tuoi comandi rapidi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriに新しいUUIDを頼んだり、自分のショートカットで使ったりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에게 새 UUID를 요청하거나 나만의 단축어에서 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Siri om een nieuwe UUID of gebruik het in je eigen opdrachten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça um novo UUID à Siri ou use-o nos seus atalhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите Siri создать новый UUID или используйте эту функцию в своих быстрых командах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri’den yeni bir UUID iste veya bunu kendi kestirmelerinde kullan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu Siri tạo UUID mới hoặc dùng trong phím tắt của riêng bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Siri 生成新的 UUID，或在你自己的快捷指令中使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請 Siri 產生新的 UUID，或在你自己的捷徑中使用。"
          }
        }
      }
    },
