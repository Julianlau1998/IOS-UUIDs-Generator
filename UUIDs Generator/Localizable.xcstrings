          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O namespace personalizado deve ser um UUID válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свое пространство имен должно быть допустимым UUID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel ad alanı geçerli bir UUID olmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Namespace tùy chỉnh phải là UUID hợp lệ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定命名空间必须是有效的 UUID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂命名空間必須是有效的 UUID。"
          }
        }
      }
    },
    "The default 21 URL-safe characters give about the same collision resistance as a UUID v4.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die standardmäßigen 21 URL-sicheren Zeichen bieten etwa dieselbe Kollisionssicherheit wie eine UUID v4."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 21 caracteres seguros para URL predeterminados ofrecen una resistencia a colisiones similar a la de un UUID v4."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 21 caractères compatibles URL par défaut offrent à peu près la même résistance aux collisions qu’un UUID v4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट 21 URL-सुरक्षित वर्ण लगभग UUID v4 जितना ही टकराव-प्रतिरोध देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I 21 caratteri sicuri per URL predefiniti offrono circa la stessa resistenza alle collisioni di un UUID v4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの21文字のURLセーフな文字で、UUID v4とほぼ同等の衝突耐性が得られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값인 URL 안전 문자 21자는 UUID v4와 비슷한 충돌 저항성을 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaard 21 URL-veilige tekens bieden ongeveer dezelfde botsingsbestendigheid als een UUID v4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os 21 caracteres seguros para URL padrão oferecem quase a mesma resistência a colisões que um UUID v4."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартные 21 безопасный для URL символ дают примерно ту же устойчивость к коллизиям, что и UUID v4."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan 21 URL için güvenli karakter, bir UUID v4 ile hemen hemen aynı çakışma direncini sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "21 ký tự an toàn cho URL mặc định có khả năng chống trùng lặp tương đương UUID v4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认的 21 个 URL 安全字符可提供与 UUID v4 大致相同的抗冲突性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設的 21 個 URL 安全字元可提供與 UUID v4 大致相同的抗碰撞性。"
          }
        }
      }
    },
    "The last %lld entries are kept. Favorites are never removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld Einträge bleiben erhalten. Favoriten werden nie entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan las últimas %lld entradas. Los favoritos nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières entrées sont conservées. Les favoris ne sont jamais supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली %lld एंट्री रखी जाती हैं। पसंदीदा कभी नहीं हटाए जाते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono conservate le ultime %lld voci. I preferiti non vengono mai rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の%lld件が保持されます。お気に入りは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %lld개 항목이 보관됩니다. 즐겨찾기는 삭제되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste %lld items worden bewaard. Favorieten worden nooit verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas %lld entradas são mantidas. Os favoritos nunca são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится до %lld последних записей. Избранное никогда не удаляется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %lld kayıt saklanır. Favoriler asla silinmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
