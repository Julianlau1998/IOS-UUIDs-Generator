    "Validate and decode UUIDs, create name-based UUIDs, ULIDs and NanoIDs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "UUIDs prüfen und dekodieren, namensbasierte UUIDs, ULIDs und NanoIDs erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valida y decodifica UUID, crea UUID basados en nombre, ULID y NanoID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide et décode des UUID, crée des UUID basés sur un nom, des ULID et des NanoID."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID सत्यापित और डिकोड करें, नाम-आधारित UUID, ULID और NanoID बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Convalida e decodifica UUID, crea UUID basati su nome, ULID e NanoID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UUIDの検証とデコード、名前ベースのUUID、ULID、NanoIDの作成。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID를 검증 및 디코딩하고, 이름 기반 UUID, ULID, NanoID를 만들어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valideer en decodeer UUID's, maak op naam gebaseerde UUID's, ULID's en NanoID's."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valide e decodifique UUIDs, crie UUIDs baseados em nome, ULIDs e NanoIDs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяйте и декодируйте UUID, создавайте UUID на основе имени, ULID и NanoID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "UUID’leri doğrula ve çöz, ada dayalı UUID’ler, ULID’ler ve NanoID’ler oluştur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực và giải mã UUID, tạo UUID dựa trên tên, ULID và NanoID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证并解码 UUID，生成基于名称的 UUID、ULID 和 NanoID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證並解碼 UUID，產生基於名稱的 UUID、ULID 和 NanoID。"
          }
        }
      }
    },
