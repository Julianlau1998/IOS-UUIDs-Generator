    "Swipe right on an entry to mark it as a favorite.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische auf einem Eintrag nach rechts, um ihn als Favorit zu markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha sobre una entrada para marcarla como favorita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie une entrée vers la droite pour l’ajouter aux favoris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी एंट्री को पसंदीदा के रूप में चिह्नित करने के लिए उस पर दाईं ओर स्वाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri a destra su una voce per aggiungerla ai preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を右にスワイプするとお気に入りに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 오른쪽으로 쓸어넘겨 즐겨찾기로 표시하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg naar rechts over een item om het als favoriet te markeren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize um item para a direita para marcá-lo como favorito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните запись вправо, чтобы добавить ее в избранное."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaydı favori olarak işaretlemek için üzerinde sağa kaydır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt sang phải trên một mục để đánh dấu là ưa thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在条目上向右轻扫即可将其收藏。"
          }
