    "Watch a short ad to create this list – or get Pro for lists of up to %@ without ads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir eine kurze Werbung an, um diese Liste zu erstellen – oder hol dir Pro für Listen mit bis zu %@ UUIDs ohne Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira un anuncio breve para crear esta lista o hazte Pro para listas de hasta %@ UUID sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regarde une courte pub pour créer cette liste – ou passe à Pro pour des listes jusqu’à %@ UUID sans pub."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सूची बनाने के लिए एक छोटा विज्ञापन देखें – या बिना विज्ञापन %@ UUID तक की सूचियों के लिए Pro पाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un breve annuncio per creare questo elenco – oppure passa a Pro per elenchi fino a %@ UUID senza pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い広告を見てこのリストを作成するか、Proで最大%@個のUUIDのリストを広告なしで作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 광고를 보고 이 목록을 만들거나, Pro로 광고 없이 최대 %@개의 목록을 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk een korte advertentie om deze lijst te maken – of neem Pro voor lijsten tot %@ UUID's zonder advertenties."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja um anúncio curto para criar esta lista – ou obtenha o Pro para listas de até %@ UUIDs sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите короткую рекламу, чтобы создать этот список, — или оформите Pro для списков до %@ UUID без рекламы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu listeyi oluşturmak için kısa bir reklam izle – ya da reklamsız, en fazla %@ UUID’lik listeler için Pro’yu al."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem một quảng cáo ngắn để tạo danh sách này – hoặc nhận Pro để tạo danh sách tối đa %@ UUID không quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看一段短广告即可生成此列表，或获取 Pro，无广告生成最多 %@ 个 UUID 的列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看一段短廣告即可產生此列表，或取得 Pro，無廣告產生最多 %@ 個 UUID 的列表。"
          }
        }
      }
    },
