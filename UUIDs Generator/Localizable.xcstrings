    "The app follows your device language. You can choose a different language for this app in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App folgt der Sprache deines Geräts. In der Einstellungen-App kannst du eine andere Sprache für diese App wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app usa el idioma de tu dispositivo. Puedes elegir otro idioma para esta app en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app suit la langue de ton appareil. Tu peux choisir une autre langue pour cette app dans l’app Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप आपके डिवाइस की भाषा का उपयोग करता है। आप सेटिंग्ज़ ऐप में इस ऐप के लिए कोई दूसरी भाषा चुन सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app segue la lingua del dispositivo. Puoi scegliere un’altra lingua per questa app nell’app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppはデバイスの言語に従います。“設定”Appでこのアプリ用に別の言語を選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 기기 언어를 따릅니다. 설정 앱에서 이 앱의 언어를 다르게 선택할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app volgt de taal van je apparaat. In de Instellingen-app kun je een andere taal voor deze app kiezen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app segue o idioma do seu dispositivo. Você pode escolher outro idioma para este app no app Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение использует язык вашего устройства. Выбрать другой язык для этого приложения можно в приложении «Настройки»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, aygıtının dilini kullanır. Bu uygulama için farklı bir dili Ayarlar uygulamasında seçebilirsin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sử dụng ngôn ngữ của thiết bị. Bạn có thể chọn ngôn ngữ khác cho ứng dụng này trong ứng dụng Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 跟随设备语言。你可以在“设置” App 中为此 App 选择其他语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 會依照裝置語言顯示。你可以在「設定」App 中為此 App 選擇其他語言。"
          }
        }
      }
    },
    "The custom namespace must be a valid UUID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene Namespace muss eine gültige UUID sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de nombres personalizado debe ser un UUID válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de noms personnalisé doit être un UUID valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम नेमस्पेस एक मान्य UUID होना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
