            "state": "translated",
            "value": "Mais IDs, mais formatos — e sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше ID, больше форматов — и никакой рекламы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha fazla kimlik, daha fazla biçim — ve reklam yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiều ID hơn, nhiều định dạng hơn – và không quảng cáo."
